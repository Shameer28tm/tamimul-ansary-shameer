# Required to enable /admin. Use a long, unique value (minimum 12 characters).
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Optional extra signing secret for admin sessions. Changing it (or ADMIN_PASSWORD)
# signs every existing admin session out. Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Canonical origin used for metadata, sitemap, robots and JSON-LD.
# Defaults to https://shameer-portfolio-topaz.vercel.app when unset.
NEXT_PUBLIC_SITE_URL=

# Optional: Google Search Console HTML-tag verification token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
